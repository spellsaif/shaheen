    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/web3.js": "^1.98.4",
    "@types/jest": "^29.5.0",
    "@types/react": "*",
    "@types/react-native": "*",
    "jest": "^29.5.0",
    "react-native": "^0.74.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
